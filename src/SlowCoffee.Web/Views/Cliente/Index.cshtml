@model IReadOnlyList<ClienteDto>
@{ViewData["Title"]="Clientes";}<div class="page-heading"><div><h1>Clientes</h1><p class="text-secondary small mb-0">Cadastro e relacionamento com clientes.</p></div><a class="btn btn-coffee" asp-action="Create">Novo cliente</a></div><div class="table-panel table-responsive"><table class="table align-middle"><thead><tr><th>Nome</th><th>Telefone</th><th>E-mail</th><th></th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.Nome</td><td>@x.Telefone</td><td>@x.Email</td><td><a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@x.Id">Editar</a><form asp-action="Delete" asp-route-id="@x.Id" method="post" class="d-inline"><button class="btn btn-sm btn-outline-danger">Inativar</button></form></td></tr>}</tbody></table></div>
