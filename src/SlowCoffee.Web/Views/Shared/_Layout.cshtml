<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="theme-color" content="#211a17"><title>@ViewData["Title"] · Slow Coffee</title>
  <link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="~/css/site.css" asp-append-version="true">
</head>
<body>
<div class="app-shell">
  <aside class="sidebar">
    <a class="brand" asp-controller="Home" asp-action="Index"><span class="brand-mark">S</span><span>slow<span class="brand-light">coffee</span><small>GESTÃO INTELIGENTE</small></span></a>
    <div class="side-label">MENU PRINCIPAL</div>
    <nav class="side-nav" aria-label="Navegação principal">
      <a asp-controller="Home" asp-action="Index"><span>◫</span> Visão geral</a>
      <a asp-controller="Pedido" asp-action="Index"><span>▤</span> Pedidos</a>
      <a asp-controller="Produto" asp-action="Index"><span>◈</span> Produtos e estoque</a>
      <a asp-controller="Cliente" asp-action="Index"><span>♙</span> Clientes</a>
      <a asp-controller="Relatorio" asp-action="Index"><span>▥</span> Relatórios</a>
    </nav>
    <div class="sidebar-bottom"><div class="online-dot"></div><span>Operação local</span><small>PIM IV · 2026</small></div>
  </aside>
  <div class="main-area">
    <header class="topbar"><div><span class="eyebrow">PLATAFORMA DE GESTÃO</span><strong>@ViewData["Title"]</strong></div><div class="topbar-right"><span class="status-pill"><i></i> Sistema operacional</span><div class="avatar">SC</div></div></header>
    <main class="content-area">@RenderBody()</main>
    <footer class="footer"><span>© 2026 Slow Coffee</span><span>Feito para simplificar a rotina.</span></footer>
  </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body></html>
