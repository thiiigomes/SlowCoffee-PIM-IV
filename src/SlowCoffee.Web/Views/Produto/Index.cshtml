@model IReadOnlyList<ProdutoDto>
@{ViewData["Title"]="Produtos";}<div class="page-heading"><div><h1>Produtos</h1><p class="text-secondary small mb-0">Catálogo, preços e disponibilidade.</p></div><a class="btn btn-coffee" asp-action="Create">Novo produto</a></div><div class="table-panel table-responsive"><table class="table align-middle"><thead><tr><th>Nome</th><th>Categoria</th><th>Preço</th><th>Estoque</th><th>Status</th><th></th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.Nome</td><td>@x.Categoria</td><td>R$ @x.Preco.ToString("N2")</td><td>@x.Estoque</td><td>@(x.Ativo?"Ativo":"Inativo")</td><td><a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@x.Id">Editar</a><form asp-action="Delete" asp-route-id="@x.Id" method="post" class="d-inline"><button class="btn btn-sm btn-outline-danger">Inativar</button></form></td></tr>}</tbody></table></div>
