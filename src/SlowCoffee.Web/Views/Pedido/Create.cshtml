@{ViewData["Title"]="Novo pedido";}<div class="page-heading"><div><h1>Novo pedido</h1><p>Registre uma venda e atualize o estoque automaticamente.</p></div></div><form asp-action="Create" method="post" class="form-panel"><div asp-validation-summary="All" class="text-danger"></div><div class="mb-3"><label class="form-label">Cliente</label><select name="clienteId" class="form-select" required>@foreach(var c in ViewBag.Clientes){<option value="@c.Id">@c.Nome</option>}</select></div><div class="mb-3"><label class="form-label">Produto</label><select name="produtoId" class="form-select" required>@foreach(var p in ViewBag.Produtos){<option value="@p.Id">@p.Nome — R$ @p.Preco.ToString("N2") (estoque @p.Estoque)</option>}</select></div><div class="mb-3"><label class="form-label">Quantidade</label><input name="quantidade" class="form-control" type="number" min="1" value="1" required></div><button class="btn btn-coffee">Criar pedido</button></form>
